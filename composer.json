{
    "name": "pageer/lnblog",
    "description": "A simple file-based weblog",
    "license": "GPL-2.0-or-later",
    "autoload": {
        "psr-4": {
            "LnBlog\\": "lib",
            "LnBlog\\Tests\\": "tests/unit",
            "LnBlog\\Plugins\\": ["lib/Plugins", "plugins"]
        },
        "classmap": [
            "plugins/*"
        ]
    },
    "require": {
        "php": ">=7.4.0",
        "ext-dom": "*",
        "erusev/parsedown": "1.7.4",
        "phpxmlrpc/phpxmlrpc": "~4.0",
        "monolog/monolog": "1.*"
    },
    "require-dev": {
        "phing/phing": "2.*",
        "squizlabs/php_codesniffer": "4.0.2",
        "phpstan/phpstan": "2.3",
        "phpunit/phpunit": "13.4.5",
        "phpspec/prophecy": "^1.17"
    }
}
