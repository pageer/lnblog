<?xml version="1.0" encoding="UTF-8"?>
<!-- Prophecy does not play well with the strict tests... -->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/13.4/phpunit.xsd" bootstrap="tests/bootstrap.php" backupGlobals="true" beStrictAboutOutputDuringTests="true" beStrictAboutTestsThatDoNotTestAnything="false" cacheDirectory=".phpunit.cache" beStrictAboutCoverageMetadata="true">
  <!--
  <coverage processUncoveredFiles="true">
    <include>
      <directory suffix=".php">plugins</directory>
      <directory suffix=".php">lib</directory>
    </include>
  </coverage>
-->
  <testsuite name="All tests">
    <directory suffix="Test.php">tests</directory>
  </testsuite>
  <source>
    <include>
      <directory suffix=".php">plugins/</directory>
      <directory suffix=".php">lib</directory>
    </include>
    <exclude>
      <directory>vendor</directory>
    </exclude>
  </source>
</phpunit>
